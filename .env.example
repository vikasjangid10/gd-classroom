# ---------------------------------------------------------------- application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json

# ---------------------------------------------------------------- database
POSTGRES_USER=gd
POSTGRES_PASSWORD=gd_password
POSTGRES_DB=gd_classroom
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------- security
# openssl rand -hex 32
JWT_SECRET=change-me-in-production-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
TICKET_TTL_SECONDS=60

# ---------------------------------------------------------------- reachability
# Everything runs on this machine by default. Change these together only if you want
# other devices to reach the app: use your LAN IP (e.g. http://192.168.0.4:5173) in all
# three, or a tunnel hostname.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- email (optional)
# OFF by default. Invitations are delivered inside the app, over each participant's
# lobby event stream — everyone taking part already has an account here, so there is
# nothing to email. /readyz reports "mail_transport": "off".
#
# Turn this on only if you also want an emailed copy with a magic join link, for people
# who are not currently looking at the app. With MAIL_ENABLED=true an invitee who has no
# account gets a passwordless one created, and the emailed token is their credential.
# With SMTP_HOST empty, mail is written to MAIL_OUTBOX_DIR as .eml files instead of sent.
#
# Gmail: SMTP_PASSWORD must be a 16-character App Password from
# https://myaccount.google.com/apppasswords (2-Step Verification required). A normal
# account password is rejected.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls        # starttls | ssl | none
MAIL_FROM=
MAIL_FROM_NAME=AI GD Classroom
MAIL_OUTBOX_DIR=/tmp/gd-outbox

# ---------------------------------------------------------------- discussion
PARTICIPANTS_PER_CLASSROOM=4
INVITATION_TTL_SECONDS=1800
SESSION_JOIN_WINDOW_SECONDS=90
TURN_MAX_SECONDS=90
# Quiet that ends an utterance. A person thinking aloud pauses far longer than a
# person dictating; 1200 cut people off mid-answer.
SILENCE_END_MS=2800
# How long you get to *begin* after the floor is handed to you. If you say nothing,
# the host checks whether you are there and hands the floor back for another
# SILENCE_AFTER_NUDGE_SECONDS before your turn is spent.
SILENCE_BEFORE_SPEAKING_SECONDS=25
SILENCE_AFTER_NUDGE_SECONDS=15
# The pause the host takes before replying to what was just said.
MODERATOR_THINK_SECONDS=1.4
# Turns in a row that produce nothing before the discussion is closed.
MAX_SILENT_TURNS=3
# Remove anyone who reads out an email address or phone number, on the spot. Their
# words are dropped rather than stored either way; this decides whether they also
# leave the round.
REMOVE_ON_PERSONAL_INFORMATION=true
DISCUSSION_MAX_SECONDS=2700
DISCUSSION_TARGET_SECONDS=1500
MIN_TURNS_PER_PARTICIPANT=2
TRANSCRIPT_RETENTION_DAYS=30

# ---------------------------------------------------------------- AI providers
# fake -> fully offline scripted moderator + synthetic audio (no keys required)
# live -> use the backends below; each port falls back to the fake independently if it
#         cannot be satisfied, and every fallback is logged at WARNING on boot.
AI_PROVIDER=fake
ALLOW_TEXT_INPUT=true

# Which adapter fills each port. "auto" picks whichever vendor has a key configured.
#
# Fully local, no keys, no accounts anywhere: AI_PROVIDER=live with TTS_BACKEND=piper
# gives a real synthesised moderator voice on this machine. The other two ports still
# need a key, and each falls back to the scripted one on its own if it does not have it.
STT_BACKEND=auto              # auto | groq | deepgram | fake
TTS_BACKEND=auto              # auto | piper | elevenlabs | fake
LLM_BACKEND=openai              # auto | openai | fake
# TWO chains, because the moderator does two different jobs.
#
#   FAST  — what the room hears: questions, hand-offs, nudges. A plain instruct model
#           beats a clever one here, and every second is dead air.
#   DEEP  — judging what a participant actually said, and writing the closing report.
#           Reasoning is the point, and nothing it produces is ever spoken aloud.
#
# Each is walked top-down; the first eligible rung serves. A rung that has spent its daily
# quota is benched until that provider's own rollover; a per-minute throttle is NOT a
# bench — it falls through for one call and the top rung is first in line again on the
# next. Each chain MUST end on a local tier.
#
# Rungs are named per lane (`gemini` vs `gemini-strong`) and so are their ledger rows,
# because a provider counts a free-tier quota per model. The two lanes deliberately lead
# with different providers, so one bad day upstream does not take out both.
# Free-first order; drop the `openai` rungs to spend nothing at all.
LLM_CHAIN_FAST=gemini,groq,huggingface,openai,scripted
LLM_CHAIN_DEEP=groq-strong,gemini-strong,huggingface-strong,openai-strong,scripted
# Whether the deep lane judges answers at all. Off (or on timeout) falls back to the
# word-count heuristic in app/domain/turn_policy.py, which is also the floor when it is on.
LLM_ASSESSMENT_ENABLED=true
# How long the room may wait for that judgement. It runs in the gap between a participant
# finishing and the moderator replying, so it is capped well under a thinking pause.
LLM_ASSESSMENT_TIMEOUT_SECONDS=6
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Groq serves reasoning models. Without this, gpt-oss-20b spends 218 of its 220 tokens
# thinking and answers with nothing at all. `low` is the floor gpt-oss accepts; the qwen
# models also take `none` (qwen/qwen3.8-27b + none is the cheapest working combination).
# Empty omits the field entirely.
GROQ_REASONING_EFFORT=low
# The deep lane's Groq rung — measured at 0.77s on the assessment prompt, the fastest
# strong model of the four. Still needs an effort setting, for the same reason.
GROQ_STRONG_LLM_MODEL=openai/gpt-oss-120b
GROQ_STRONG_REASONING_EFFORT=low
# Once hunting for a working hosted provider has cost this long, skip the rest of the
# hosted rungs and take the local one: per-rung ceilings bound each attempt, not the sum.
# Five rungs cannot be walked in the twelve seconds two could — and it only ever costs
# this on the first call after a provider goes down, since a benched rung costs nothing.
LLM_FAILOVER_BUDGET_SECONDS=25
# Above this, a 429's retry-after means "done for the day"; below, "busy for a moment".
LLM_DAILY_QUOTA_THRESHOLD_SECONDS=300
# One blip is not an outage. Bench after this many failures in a row; any success resets.
LLM_TRANSIENT_FAILURES_BEFORE_BENCH=3
# A local model, if you run one. Empty means the rung is skipped with a reason.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# ---- LLM rung 1: Gemini, through Google's OpenAI-compatible endpoint (no extra SDK).
#      Free tier, key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A *lite* model on purpose: the moderator writes one sentence, and the reasoning flash
# models (gemini-3.6-flash, gemini-3.7-flash) spend the whole 220-token budget thinking
# and return an empty or truncated answer. Measured: lite 1.5s and a complete sentence,
# 3.6-flash 3.8s truncated, 3.7-flash 44s truncated.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# The deep lane's Gemini rung. Here reasoning is the point, not the problem.
# Watch the free tier: gemini-3.5-flash allows **20 requests per day**
# (quotaId GenerateRequestsPerDayPerProjectPerModel-FreeTier), and one 15-minute
# discussion spends about nine of them. That is why it is the *second* deep rung.
GEMINI_STRONG_MODEL=gemini-3.5-flash

# ---- LLM rung 3: the Hugging Face router, one key in front of several inference
#      providers. Free monthly credits, key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_STRONG_MODEL=deepseek-ai/DeepSeek-V4-Flash
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ---- LLM: the moderator's questions, follow-ups and closing summary
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Not a gpt-5 model: those reject `max_tokens` and any temperature but 1, and this whole
# package is built on one wire format rather than a branch per vendor.
OPENAI_STRONG_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- STT: Groq Whisper (a file endpoint, so the adapter does its own utterance
#      detection — see app/infrastructure/ai/groq_stt.py). Key: https://console.groq.com
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Seconds of continuous speech between live-caption passes. 0 = finals only, cheapest.
STT_INTERIM_SECONDS=4

# ---- STT alternative: Deepgram (true streaming WebSocket)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- TTS: Piper runs locally. No key, no cost, no network at synthesis time. The
#      voice (~60 MB) is downloaded into the `piper` volume on first boot.
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=/app/.piper/en_US-lessac-medium.onnx

# ---- TTS alternative: ElevenLabs (hosted, streaming)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------------------------------------------------------------- WebRTC
# STUN is enough while everyone is on the same network. Across the internet — a phone on
# mobile data, a laptop behind a corporate NAT — you need TURN, or audio silently fails
# while everything else works.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ---------------------------------------------------------------- frontend
# Must be reachable from the participant's device, exactly like PUBLIC_APP_URL.
VITE_API_BASE_URL=http://localhost:8000
